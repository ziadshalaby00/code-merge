{
  "name": "code-merge",
  "displayName": "code merge",
  "description": "Select files or code snippets and merge them into a single file with headers showing file path and line range",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-merge.addFile",
        "title": "Code Merge: Add File",
        "icon": "$(file-add)"
      },
      {
        "command": "code-merge.addSelection",
        "title": "Code Merge: Add Selection",
        "icon": "$(selection)"
      },
      {
        "command": "code-merge.deleteItem",
        "title": "Delete Item",
        "icon": "$(trash)"
      },
      {
        "command": "code-merge.openPreview",
        "title": "Open Merged Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "code-merge.copyAll",
        "title": "Copy Merged Content",
        "icon": "$(copy)"
      },
      {
        "command": "code-merge.clearAll",
        "title": "Clear All",
        "icon": "$(trash)"
      },
      {
        "command": "code-merge.addFolder",
        "title": "Code Merge: Add Folder",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "code-merge.addFile",
          "when": "resourceScheme == file",
          "group": "navigation@9"
        },
        {
          "command": "code-merge.addFolder",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "code-merge.addSelection",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "code-merge.deleteItem",
          "when": "view == codeMerge.items",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "code-merge.openPreview",
          "when": "view == codeMerge.items",
          "group": "navigation@1"
        },
        {
          "command": "code-merge.copyAll",
          "when": "view == codeMerge.items",
          "group": "navigation@2"
        },
        {
          "command": "code-merge.clearAll",
          "when": "view == codeMerge.items",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "code-merge.copyAll",
          "when": "resourceFilename == merged.md && resourceDirname =~ /code-merge/",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "code-merge.addSelection",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "code-merge.addFile",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "explorerViewletVisible && filesExplorerFocus"
      },
      {
        "command": "code-merge.addFolder",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+f",
        "when": "explorerViewletVisible && filesExplorerFocus"
      },
      {
        "command": "code-merge.openPreview",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "code-merge.copyAll",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeMerge",
          "title": "Code Merge",
          "icon": "resources/icons/activity.svg"
        }
      ]
    },
    "views": {
      "codeMerge": [
        {
          "id": "codeMerge.items",
          "name": "Selected Items",
          "icon": "$(list-tree)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.5",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
