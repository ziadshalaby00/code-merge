{
  "name": "code-merge",
  "displayName": "Code Merge",
  "description": "Select files, folders, or code selections and merge them into a single markdown file with a project tree and per-file headers.",
  "version": "0.1.0",
  "publisher": "ziadshalaby00",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ziadshalaby00/code-merge.git"
  },
  "bugs": {
    "url": "https://github.com/ziadshalaby00/code-merge/issues"
  },
  "homepage": "https://github.com/ziadshalaby00/code-merge#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "keywords": [
    "merge",
    "concatenate",
    "context",
    "llm",
    "ai",
    "markdown",
    "copy"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-merge.addFile",
        "title": "Code Merge: Add File",
        "icon": "$(file-add)"
      },
      {
        "command": "code-merge.addFolder",
        "title": "Code Merge: Add Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "code-merge.addSelection",
        "title": "Code Merge: Add Selection",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "code-merge.deleteItem",
        "title": "Code Merge: Delete Item",
        "icon": "$(trash)"
      },
      {
        "command": "code-merge.openPreview",
        "title": "Code Merge: Open Merged Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "code-merge.copyAll",
        "title": "Code Merge: Copy Merged Content",
        "icon": "$(copy)"
      },
      {
        "command": "code-merge.clearAll",
        "title": "Code Merge: Clear All",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "code-merge.addFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "code-merge.addFolder",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "code-merge.addSelection",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "code-merge.deleteItem",
          "when": "view == codeMerge.items",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "code-merge.openPreview",
          "when": "view == codeMerge.items",
          "group": "navigation@1"
        },
        {
          "command": "code-merge.copyAll",
          "when": "view == codeMerge.items",
          "group": "navigation@2"
        },
        {
          "command": "code-merge.clearAll",
          "when": "view == codeMerge.items",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "code-merge.copyAll",
          "when": "resourceFilename == merged.md && resourceDirname =~ /\\.code-merge$/",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "code-merge.addSelection",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "code-merge.addFile",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "explorerViewletVisible && filesExplorerFocus"
      },
      {
        "command": "code-merge.addFolder",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+f",
        "when": "explorerViewletVisible && filesExplorerFocus"
      },
      {
        "command": "code-merge.openPreview",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "code-merge.copyAll",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeMerge",
          "title": "Code Merge",
          "icon": "resources/icons/activity.svg"
        }
      ]
    },
    "views": {
      "codeMerge": [
        {
          "id": "codeMerge.items",
          "name": "Selected Items",
          "icon": "$(list-tree)",
          "contextualTitle": "Code Merge"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.20.0",
    "eslint": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}