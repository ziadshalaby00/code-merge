{
  "name": "code-merge",
  "displayName": "Code Merge",
  "description": "Select files, folders, or code snippets and merge them into a live markdown preview with a project tree, per-file headers, item counts, and configurable ignore rules.",
  "version": "0.5.0",
  "icon": "resources/icon.png",
  "publisher": "ziadshalaby00",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ziadshalaby00/code-merge.git"
  },
  "bugs": {
    "url": "https://github.com/ziadshalaby00/code-merge/issues"
  },
  "homepage": "https://github.com/ziadshalaby00/code-merge#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "merge",
    "concatenate",
    "context",
    "llm",
    "ai",
    "markdown",
    "copy",
    "ignore",
    "gitignore"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-merge.addFile",
        "title": "Code Merge: Add File",
        "icon": "$(file-add)"
      },
      {
        "command": "code-merge.addFolder",
        "title": "Code Merge: Add Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "code-merge.addSelection",
        "title": "Code Merge: Add Selection",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "code-merge.deleteItem",
        "title": "Code Merge: Delete Item",
        "icon": "$(trash)"
      },
      {
        "command": "code-merge.openPreview",
        "title": "Code Merge: Open Merged Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "code-merge.copyAll",
        "title": "Code Merge: Copy Merged Content",
        "icon": "$(copy)"
      },
      {
        "command": "code-merge.clearAll",
        "title": "Code Merge: Clear All",
        "icon": "$(clear-all)"
      },
      {
        "command": "code-merge.openIgnoreSettings",
        "title": "Code Merge: Open Ignore Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "code-merge.reloadIgnoreRules",
        "title": "Code Merge: Reload Ignore Rules",
        "icon": "$(refresh)"
      },
      {
        "command": "code-merge.ignorePath",
        "title": "Code Merge: Ignore This Path",
        "icon": "$(circle-slash)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "code-merge.addFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "code-merge.addFolder",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "code-merge.ignorePath",
          "when": "resourceScheme == file",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "code-merge.addSelection",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "code-merge.deleteItem",
          "when": "view == codeMerge.items",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "code-merge.openPreview",
          "when": "view == codeMerge.items",
          "group": "navigation@1"
        },
        {
          "command": "code-merge.copyAll",
          "when": "view == codeMerge.items",
          "group": "navigation@2"
        },
        {
          "command": "code-merge.clearAll",
          "when": "view == codeMerge.items",
          "group": "navigation@3"
        },
        {
          "command": "code-merge.openIgnoreSettings",
          "when": "view == codeMerge.items",
          "group": "navigation@4"
        },
        {
          "command": "code-merge.reloadIgnoreRules",
          "when": "view == codeMerge.items",
          "group": "navigation@5"
        }
      ],
      "editor/title": [
        {
          "command": "code-merge.copyAll",
          "when": "resourceScheme == code-merge",
          "group": "navigation@1"
        },
        {
          "command": "code-merge.clearAll",
          "when": "resourceScheme == code-merge",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "code-merge.addSelection",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "code-merge.addFile",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "explorerViewletVisible && filesExplorerFocus"
      },
      {
        "command": "code-merge.addFolder",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+f",
        "when": "explorerViewletVisible && filesExplorerFocus"
      },
      {
        "command": "code-merge.openPreview",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "code-merge.copyAll",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeMerge",
          "title": "Code Merge",
          "icon": "resources/icons/activity.svg"
        }
      ]
    },
    "views": {
      "codeMerge": [
        {
          "id": "codeMerge.items",
          "name": "Selected Items",
          "icon": "$(list-tree)",
          "contextualTitle": "Code Merge"
        }
      ]
    },
    "configuration": {
      "title": "Code Merge",
      "properties": {
        "code-merge.ignore.additionalDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra directory names to skip on top of the built-in list."
        },
        "code-merge.ignore.additionalExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra file extensions to skip, e.g. pdf, zip, parquet."
        },
        "code-merge.ignore.additionalFilePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra gitignore-style patterns, e.g. *.log, secrets/*."
        },
        "code-merge.ignore.dotDirAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".github",
            ".gitlab",
            ".devcontainer"
          ],
          "description": "Dot-directories that should be traversed instead of skipped."
        },
        "code-merge.ignore.file": {
          "type": "string",
          "default": ".code-mergeignore",
          "description": "Per-project ignore file (gitignore syntax). Leave empty to disable."
        },
        "code-merge.ignore.useGitignore": {
          "type": "boolean",
          "default": false,
          "description": "Also honor the workspace .gitignore file."
        },
        "code-merge.maxFileSizeMB": {
          "type": "number",
          "default": 5,
          "minimum": 0.1,
          "description": "Maximum size (in MB) for a file or selection to be merged."
        },
        "code-merge.autoOpenPreview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the merged preview when items are added, if it isn't already open."
        },
        "code-merge.maxPreviewSizeChars": {
          "type": "number",
          "default": 5000000,
          "minimum": 50000,
          "description": "Maximum total size (characters) of the merged output. If live edits push the merged content past this limit, the preview is closed automatically to avoid slowing down the editor. It can still be reopened manually."
        } 
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.20.0",
    "eslint": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "ignore": "^7.0.9"
  }
}
